      "roundness": null,
      "seed": 1273636569,
      "version": 29,
      "versionNonce": 279398809,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790448733576,
      "link": null,
      "locked": false,
      "text": "Um agente de IA é um programa que usa um modelo de linguagem (como o GPT ou o Claude) \npara entender um objetivo, decidir o que fazer e agir para o cumprir, em vez de apenas responder com texto.\n\nChatbot = responde perguntas.\nAgente = responde e faz coisas.\n\n\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Um agente de IA é um programa que usa um modelo de linguagem (como o GPT ou o Claude) \npara entender um objetivo, decidir o que fazer e agir para o cumprir, em vez de apenas responder com texto.\n\nChatbot = responde perguntas.\nAgente = responde e faz coisas.\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
